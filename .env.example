# ==============================================================================
# SWEET BLISS BAKERY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your secret production values.
# NEVER commit .env to version control or public repositories.
# ==============================================================================

# Application Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. STORE ADMINISTRATOR CREDENTIALS
# Generate strong random keys for production:
# e.g., openssl rand -hex 32
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_KEY=your_secure_random_admin_api_key_here

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY CREDENTIALS (INR / UPI / Cards / Net Banking)
# Sign in to https://dashboard.razorpay.com/ -> Settings -> API Keys
# Public Key ID is shared with frontend; Key Secret must remain strictly server-side.
# ------------------------------------------------------------------------------
# Razorpay Key ID (Starts with rzp_live_... for production, or rzp_test_... for sandbox)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here

# Razorpay Key Secret (Keep confidential on server)
RAZORPAY_KEY_SECRET=your_actual_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI PASTRY CHEF
# Required for real-time generative cake concept briefs and custom flavor pairings.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here